{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "Rqlite.Client/bin/**/*.dll"
          ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "noRestore": false,
      "namespaceLayout": "flattened",
      "memberLayout": "separatePages",
      "enumSortOrder": "alphabetic",
      "allowCompilationErrors": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md",
          "index.md",
          "toc.yml",
          "docs/**.md",
          "docs/toc.yml"
        ]
      }
    ],
    "globalMetadata": {
      "_appTitle": "Rqlite",
      "_appName": "Rqlite",
      "_appFooter": "<span>Copyright &copy; 2023-2026 <a href=\"https://bfren.dev\">bfren</a>. Made with <a href=\"https://dotnet.github.io/docfx\">docfx</a></span>"
    },
    "sitemap": {
      "baseUrl": "https://bfren.github.io/rqlite",
      "priority": 0.5,
      "changefreq": "daily"
    },
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "postProcessors": [],
    "disableGitFeatures": false
  }
}
